# Chat route. Without a key the chat runs through Claude Code with your own Claude login.
# Set a key to use the Claude API instead (needed before you share the page with anyone).
ANTHROPIC_API_KEY=
# CHAT_BACKEND=claude-code   # or api: force a route
# CLAUDE_CODE_BIN=/path/to/claude
# Optional
# PORT=5180
# CLAUDE_MODEL=claude-opus-5-5
